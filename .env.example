# Copy to .env and load it in the shell before starting the application.
# Do not commit real passwords.
DATABASE_URL=postgresql://USER:PASSWORD@DB_HOST:5432/car_scan
# For source runs, use the same external URL under this application variable.
CAR_SCAN_DATABASE_URL=postgresql://USER:PASSWORD@DB_HOST:5432/car_scan
# Shared only between OneVision Report (server-side proxy) and this Car Scan API.
# Use a long random value; never expose it in client-side/public runtime config.
# Shared secret required by OneVision Report's CAR_SCAN_TRAIN_API_TOKEN.
CAR_SCAN_TRAIN_API_TOKEN=
CAR_SCAN_ROOT=.
CAR_SCAN_OUTPUT_DIR=./scan/data
# Camera identifier used in archived names for image/video inputs (live camera uses its selected index).
CAR_SCAN_ARCHIVE_CAMERA_ID=0
# Optional: used by auto/auto_ai_set_labels.py. Keep the real key in .env only.
AI_LABEL_API_KEY=
# Alternatively set the provider-specific key: OPENAI_API_KEY, GOOGLE_API_KEY
# (or GEMINI_API_KEY), or OPENROUTER_API_KEY.
OPENAI_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Required only for downloading training datasets from Roboflow.
ROBOFLOW_API_KEY=
CAR_SCAN_DETECTOR_CONFIDENCE=0.35
CAR_SCAN_VEHICLE_TYPE_CONFIDENCE=0.25
CAR_SCAN_PLATE_TYPE_CONFIDENCE=0.25
CAR_SCAN_CHARACTER_CONFIDENCE=0.20
CAR_SCAN_PADDING=0.03
CAR_SCAN_IMGSZ=640
CAR_SCAN_VIDEO_FRAME_STRIDE=1
CAR_SCAN_VIDEO_TARGET_SCANS_PER_SECOND=2.0
CAR_SCAN_VIDEO_MIN_CONFIRMATIONS=3
CAR_SCAN_CAMERA_FRAME_STRIDE=2
CAR_SCAN_CAMERA_MIN_CONFIRMATIONS=2
# Live CCTV cadence in seconds. A lane that detects a plate just outside the
# ROI automatically changes from idle to the faster hot interval.
CAR_SCAN_CAMERA_IDLE_SUBMIT_INTERVAL=0.18
CAR_SCAN_CAMERA_HOT_SUBMIT_INTERVAL=0.08
# Keep 1080p CCTV plates at full size so Thai series letters stay readable.
CAR_SCAN_CAMERA_INFER_MAX_DIMENSION=1920
CAR_SCAN_TEMPORAL_MIN_QUALITY=0.58
CAR_SCAN_TARGET_FPS=24.0
# Live CCTV is sent at the camera's reported frame rate (up to this cap) and
# native resolution at JPEG quality 100. This cap is not adaptive by camera count.
CAR_SCAN_PREVIEW_FPS=60.0
# Image/video preview resize setting; live CCTV bypasses this limit.
CAR_SCAN_PREVIEW_MAX_DIMENSION=1280
# Where YOLO/OCR run: auto (GPU YOLO + CPU OCR when CUDA exists), gpu, cpu,
# or hybrid (GPU keeps live plates, CPU scans idle cameras in parallel).
CAR_SCAN_COMPUTE=auto
# Limit disk-heavy rejected training samples during a live stream.
CAR_SCAN_MAX_REJECTED_EVIDENCE_PER_RUN=20
CAR_SCAN_REJECTED_EVIDENCE_FRAME_GAP=24
# Refresh vehicle classification every N sampled frames. Plate recognition
# still runs on every sampled frame.
CAR_SCAN_STREAM_VEHICLE_REFRESH_SCANS=3
# 1 = scan every video/camera frame and run complete OCR for maximum accuracy (slower).
CAR_SCAN_FULL_ACCURACY_MODE=0
# Web app bind address. Use 127.0.0.1 for local only.
CAR_SCAN_WEB_HOST=127.0.0.1
CAR_SCAN_WEB_PORT=8000
# Max upload size for the web app, in megabytes. Videos often exceed 500MB.
CAR_SCAN_WEB_MAX_UPLOAD_MB=4096
# Gate IP cameras (RTSP). Comma-separate multiple cameras. Keep passwords in .env only.
# Example: rtsp://USER:PASSWORD@192.168.100.50:554/Streaming/Channels/101,rtsp://USER:PASSWORD@192.168.100.191:554/Streaming/Channels/101
CAR_SCAN_IP_CAMERA_URL=
# Optional extra cameras, comma-separated.
CAR_SCAN_IP_CAMERA_URLS=
# PostgreSQL is external; Docker Compose does not create or manage a database container.
# auto/fast skips vehicle inference when no plate is found; full classifies vehicles first.
CAR_SCAN_PIPELINE_MODE=auto
CAR_SCAN_PIPELINE_CONFIG=./pipeline_config.yaml
# Optional plate-type model. Leave empty until a trained model is available.
CAR_SCAN_PLATE_TYPE_MODEL=
# Save stage-oriented diagnostic images and JSON under scan/data/YYYYMMDD/debug.
CAR_SCAN_DEBUG=0
# Web login. Change these before exposing the app.
CAR_SCAN_ADMIN_USERNAME=admin
CAR_SCAN_ADMIN_PASSWORD=changeme
CAR_SCAN_AUTH_SECRET=
# Read-only live events for OneVision-report. For local development leave
# the token empty; only localhost:3000/127.0.0.1:3000 may subscribe. In a
# deployed environment set the same token in OneVision-report's .env.
ONEVISION_REPORT_WS_TOKEN=
# Comma-separated report origins allowed when no token is configured.
ONEVISION_REPORT_WS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Central Storage Service. Keep the real API token only in .env.
STORAGE_SERVICE_BASE_URL=http://10.0.200.205:8080
STORAGE_SERVICE_PROJECT_CODE=onevision
STORAGE_SERVICE_API_TOKEN=your-project-api-token
ONEVISION_REPORT_DATA_URL=http://10.0.200.205:3008/api/dataset/storage
ONEVISION_REPORT_IMAGE_URL=http://10.0.200.205:3008/api/plates/image
# Optional remote CPU training workers. Dataset source of truth stays here;
# only a temporary per-run bundle is sent over SSH, then removed from worker.
# For production Docker, combine docker-compose.yml with docker-compose.training.yml.
CAR_SCAN_TRAIN_WORKERS=[{"id":"nginx01","name":"nginx01 · CPU (8 cores)","host":"10.0.200.12","user":"admindev","dockerImage":"car-scan-web:local","device":"cpu","cpus":4,"memory":"6g"}]
# Paths inside the app container. Never store the private key or password here.
CAR_SCAN_TRAIN_SSH_KEY=/run/secrets/training_worker_key
CAR_SCAN_TRAIN_SSH_KNOWN_HOSTS=/run/secrets/training_worker_known_hosts
# Host paths mounted by docker-compose.training.yml (set for production deploys).
CAR_SCAN_TRAIN_SSH_KEY_FILE=/etc/onevision/secrets/training_worker_key
CAR_SCAN_TRAIN_SSH_KNOWN_HOSTS_FILE=/etc/onevision/secrets/training_worker_known_hosts
# After pip install, generate the Prisma client once:
#   .venv\Scripts\python.exe db\prisma_cli.py generate
# Then create/update tables:
#   .venv\Scripts\python.exe db\prisma_cli.py db push
# Tests keep users in SQLite when CAR_SCAN_AUTH_DB is set.
